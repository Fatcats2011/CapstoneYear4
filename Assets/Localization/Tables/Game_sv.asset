    m_Metadata:
      m_Items: []
  - m_Id: 11191324727
    m_Localized: "Inga \xF6ppna matcher just nu. Din lobby \xE4r \xF6ppen f\xF6r
      alla."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324728
    m_Localized: "Inga \xF6ppna matcher just nu."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324729
    m_Localized: "Leta efter en match innan andra g\xE5r med i din lobby."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324730
    m_Localized: "Den matchen \xE4r full."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324731
    m_Localized: "Den matchen har redan b\xF6rjat."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324732
    m_Localized: "Det spelet \xE4r inte Dead on Arrival."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324733
    m_Localized: "Den lobbyn \xE4r ingen Dead on Arrival-match."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324734
    m_Localized: "Avsluta din match innan du g\xE5r med i en v\xE4ns."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324735
    m_Localized: "L\xE4mna din onlinematch innan du g\xE5r med i en annan."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324736
    m_Localized: "Den matchen k\xF6r version {0} och du har {1}. Ni beh\xF6ver samma
      version."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324737
    m_Localized: "en ok\xE4nd version"
    m_Metadata:
      m_Items: []
  - m_Id: 11191324738
    m_Localized: "Den matchen k\xF6r ett annat bygge av version {0}. Ni beh\xF6ver
      samma bygge."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324739
    m_Localized: "Starta Steam f\xF6r att spela online."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324740
    m_Localized: "Steam kunde inte \xF6ppna en lobby. F\xF6rs\xF6k igen."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324741
    m_Localized: "Det gick inte att starta onlinematchen. F\xF6rs\xF6k igen."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324742
    m_Localized: "Kunde inte g\xE5 med i matchen. Den kan ha tagit slut."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324743
    m_Localized: "Bjud in v\xE4nner fr\xE5n din v\xE4nlista p\xE5 Steam."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324744
    m_Localized: "Fr\xE5nkopplad: f\xF6r m\xE5nga meddelanden."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324745
    m_Localized: "Borttagen fr\xE5n returmatchen."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324746
    m_Localized: "V\xE4rden l\xE4mnade matchen."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324747
    m_Localized: "Kunde inte n\xE5 v\xE4rden."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324748
    m_Localized: "Anslutningen br\xF6ts."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324749
    m_Localized: "Y / Triangel: spela online med Steam-v\xE4nner"
    m_Metadata:
      m_Items: []
  - m_Id: 11191324750
    m_Localized: "Y / Triangel: bjud in v\xE4nner      B / Cirkel: l\xE4mna"
    m_Metadata:
      m_Items: []
  - m_Id: 11191324751
    m_Localized: "B / Cirkel: l\xE4mna online"
    m_Metadata:
      m_Items: []
