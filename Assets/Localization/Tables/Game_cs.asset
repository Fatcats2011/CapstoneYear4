      m_Items: []
  - m_Id: 11191324726
    m_Localized: "OTEV\u0158ENO V\u0160EM \xB7 ZA\u010C\xC1TEK ZA {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 11191324727
    m_Localized: "Te\u010F nejsou \u017E\xE1dn\xE9 otev\u0159en\xE9 z\xE1pasy. Tvoje
      m\xEDstnost je otev\u0159en\xE1 v\u0161em."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324728
    m_Localized: "Te\u010F nejsou \u017E\xE1dn\xE9 otev\u0159en\xE9 z\xE1pasy."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324729
    m_Localized: "Hledej z\xE1pas d\u0159\xEDv, ne\u017E se ostatn\xED p\u0159ipoj\xED
      do tv\xE9 m\xEDstnosti."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324730
    m_Localized: "Ten z\xE1pas je pln\xFD."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324731
    m_Localized: "Ten z\xE1pas u\u017E za\u010Dal."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324732
    m_Localized: "Tohle nen\xED Dead on Arrival."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324733
    m_Localized: "Tahle m\xEDstnost nen\xED z\xE1pas Dead on Arrival."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324734
    m_Localized: "Dohraj sv\u016Fj z\xE1pas, ne\u017E se p\u0159ipoj\xED\u0161 ke
      kamar\xE1dovi."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324735
    m_Localized: "Opus\u0165 sv\u016Fj online z\xE1pas, ne\u017E se p\u0159ipoj\xED\u0161
      k jin\xE9mu."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324736
    m_Localized: "Ten z\xE1pas b\u011B\u017E\xED ve verzi {0} a ty m\xE1\u0161 {1}.
      Pot\u0159ebujete stejnou verzi."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324737
    m_Localized: "nezn\xE1mou verzi"
    m_Metadata:
      m_Items: []
  - m_Id: 11191324738
    m_Localized: "Ten z\xE1pas b\u011B\u017E\xED na jin\xE9m sestaven\xED verze {0}.
      Pot\u0159ebujete stejn\xE9 sestaven\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324739
    m_Localized: "Spus\u0165 Steam, abys mohl hr\xE1t online."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324740
    m_Localized: "Steam nedok\xE1zal otev\u0159\xEDt m\xEDstnost. Zkus to znovu."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324741
    m_Localized: "Online z\xE1pas se nepoda\u0159ilo spustit. Zkus to znovu."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324742
    m_Localized: "K z\xE1pasu se nepoda\u0159ilo p\u0159ipojit. Mo\u017En\xE1 skon\u010Dil."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324743
    m_Localized: "Pozvi p\u0159\xE1tele ze seznamu p\u0159\xE1tel na Steamu."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324744
    m_Localized: "Odpojeno: p\u0159\xEDli\u0161 mnoho zpr\xE1v."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324745
    m_Localized: "Vy\u0159azen z odvety."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324746
    m_Localized: "Hostitel opustil z\xE1pas."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324747
    m_Localized: "Hostitel nen\xED dostupn\xFD."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324748
    m_Localized: "Spojen\xED se ztratilo."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324749
    m_Localized: "Y / Troj\xFAheln\xEDk: hr\xE1t online s p\u0159\xE1teli ze Steamu"
    m_Metadata:
      m_Items: []
  - m_Id: 11191324750
    m_Localized: "Y / Troj\xFAheln\xEDk: pozvat p\u0159\xE1tele      B / Kole\u010Dko:
      odej\xEDt"
    m_Metadata:
      m_Items: []
  - m_Id: 11191324751
    m_Localized: "B / Kole\u010Dko: opustit online"
    m_Metadata:
      m_Items: []
  - m_Id: 11191324752
    m_Localized: "Hr\xE1\u010D {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 11191324753
    m_Localized: "P\u0159ipoj ovlada\u010D a hraj"
    m_Metadata:
      m_Items: []
  - m_Id: 11191324754
    m_Localized: "Stiskni mezern\xEDk a hraj na kl\xE1vesnici, nebo p\u0159ipoj ovlada\u010D"
    m_Metadata:
      m_Items: []
  - m_Id: 11191324755
    m_Localized: "Tento ovlada\u010D nen\xED podporov\xE1n - zkus ovlada\u010D Xbox,
      PlayStation nebo Switch Pro"
    m_Metadata:
      m_Items: []
  - m_Id: 11191324756
    m_Localized: "Ovlada\u010D H{0} odpojen\nPokra\u010Duj stiskem tla\u010D\xEDtka
      na libovoln\xE9m ovlada\u010Di"
    m_Metadata:
      m_Items: []
  - m_Id: 11191324757
    m_Localized: "Sk\xF3re"
    m_Metadata:
      m_Items: []
  - m_Id: 11191324758
    m_Localized: "Hr\xE1\u010D 1"
    m_Metadata:
      m_Items: []
  - m_Id: 11191324759
    m_Localized: "Zlat\xE1 zak\xE1zka za..."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324760
    m_Localized: "Zapnout v\xFDuku"
    m_Metadata:
      m_Items: []
