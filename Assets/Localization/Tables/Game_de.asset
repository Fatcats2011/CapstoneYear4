    m_Metadata:
      m_Items: []
  - m_Id: 11191324739
    m_Localized: Starte Steam, um online zu spielen.
    m_Metadata:
      m_Items: []
  - m_Id: 11191324740
    m_Localized: "Steam konnte keine Lobby \xF6ffnen. Versuch es noch mal."
