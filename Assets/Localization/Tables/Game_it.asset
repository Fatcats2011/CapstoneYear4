    m_Metadata:
      m_Items: []
  - m_Id: 11191324737
    m_Localized: una versione sconosciuta
    m_Metadata:
      m_Items: []
  - m_Id: 11191324738
    m_Localized: "Quella partita \xE8 su un'altra build della versione {0}. Vi serve
      la stessa build."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324739
    m_Localized: Avvia Steam per giocare online.
    m_Metadata:
      m_Items: []
  - m_Id: 11191324740
    m_Localized: "Steam non \xE8 riuscito ad aprire una lobby. Riprova."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324741
    m_Localized: Impossibile avviare la partita online. Riprova.
    m_Metadata:
      m_Items: []
  - m_Id: 11191324742
    m_Localized: "Impossibile unirsi a quella partita. Forse \xE8 finita."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324743
    m_Localized: Invita gli amici dalla tua lista amici di Steam.
    m_Metadata:
      m_Items: []
  - m_Id: 11191324744
    m_Localized: 'Disconnesso: troppi messaggi.'
    m_Metadata:
      m_Items: []
