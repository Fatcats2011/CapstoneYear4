    m_Metadata:
      m_Items: []
  - m_Id: 11191324720
    m_Localized: "MESA\u0130YE BA\u015ELA"
    m_Metadata:
      m_Items: []
  - m_Id: 11191324721
    m_Localized: "T\xDCM S\u0130PAR\u0130\u015ELER YOLDA"
    m_Metadata:
      m_Items: []
  - m_Id: 11191324722
    m_Localized: "MA\xC7 ARANIYOR\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 11191324723
    m_Localized: "HERKESE A\xC7IK"
    m_Metadata:
      m_Items: []
  - m_Id: 11191324724
    m_Localized: "SADECE ARKADA\u015ELAR"
    m_Metadata:
      m_Items: []
  - m_Id: 11191324725
    m_Localized: "MA\xC7 BUL"
    m_Metadata:
      m_Items: []
  - m_Id: 11191324726
    m_Localized: "HERKESE A\xC7IK \xB7 {0} SN SONRA BA\u015ELIYOR"
    m_Metadata:
      m_Items: []
  - m_Id: 11191324727
    m_Localized: "\u015Eu an a\xE7\u0131k ma\xE7 yok. Lobin herkese a\xE7\u0131k."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324728
    m_Localized: "\u015Eu an a\xE7\u0131k ma\xE7 yok."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324729
    m_Localized: "Ba\u015Fkalar\u0131 lobine kat\u0131lmadan \xF6nce ma\xE7 ara."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324730
    m_Localized: "O ma\xE7 dolu."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324731
    m_Localized: "O ma\xE7 \xE7oktan ba\u015Flad\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324732
    m_Localized: "O oyun Dead on Arrival de\u011Fil."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324733
    m_Localized: "O lobi bir Dead on Arrival ma\xE7\u0131 de\u011Fil."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324734
    m_Localized: "Bir arkada\u015F\u0131na kat\u0131lmadan \xF6nce ma\xE7\u0131n\u0131
      bitir."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324735
    m_Localized: "Ba\u015Fka birine kat\u0131lmadan \xF6nce \xE7evrimi\xE7i ma\xE7\u0131ndan
      \xE7\u0131k."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324736
    m_Localized: "O ma\xE7 {0} s\xFCr\xFCm\xFCnde, sende {1} var. Ayn\u0131 s\xFCr\xFCme
      ihtiyac\u0131n\u0131z var."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324737
    m_Localized: "bilinmeyen bir s\xFCr\xFCm"
    m_Metadata:
      m_Items: []
  - m_Id: 11191324738
    m_Localized: "O ma\xE7 {0} s\xFCr\xFCm\xFCn\xFCn ba\u015Fka bir derlemesinde.
      Ayn\u0131 derlemeye ihtiyac\u0131n\u0131z var."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324739
    m_Localized: "\xC7evrimi\xE7i oynamak i\xE7in Steam'i ba\u015Flat."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324740
    m_Localized: "Steam bir lobi a\xE7amad\u0131. Tekrar dene."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324741
    m_Localized: "\xC7evrimi\xE7i ma\xE7 ba\u015Flat\u0131lamad\u0131. Tekrar dene."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324742
    m_Localized: "O ma\xE7a kat\u0131l\u0131namad\u0131. Bitmi\u015F olabilir."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324743
    m_Localized: "Steam arkada\u015F listenden arkada\u015Flar\u0131n\u0131 davet
      et."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324744
    m_Localized: "Ba\u011Flant\u0131 kesildi: \xE7ok fazla mesaj."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324745
    m_Localized: "R\xF6van\u015Ftan \xE7\u0131kar\u0131ld\u0131n."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324746
    m_Localized: "Ev sahibi ma\xE7tan ayr\u0131ld\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324747
    m_Localized: "Ev sahibine ula\u015F\u0131lamad\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324748
    m_Localized: "Ba\u011Flant\u0131 koptu."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324749
    m_Localized: "Y / \xDC\xE7gen: Steam arkada\u015Flar\u0131nla \xE7evrimi\xE7i
      oyna"
    m_Metadata:
      m_Items: []
  - m_Id: 11191324750
    m_Localized: "Y / \xDC\xE7gen: arkada\u015F davet et      B / Daire: ayr\u0131l"
    m_Metadata:
      m_Items: []
  - m_Id: 11191324751
    m_Localized: "B / Daire: \xE7evrimi\xE7iden \xE7\u0131k"
    m_Metadata:
      m_Items: []
  - m_Id: 11191324752
    m_Localized: Oyuncu {0}
    m_Metadata:
      m_Items: []
  - m_Id: 11191324753
    m_Localized: "Oynamak i\xE7in bir kumanda ba\u011Fla"
    m_Metadata:
      m_Items: []
  - m_Id: 11191324754
    m_Localized: "Klavyeyle oynamak i\xE7in Bo\u015Fluk'a bas ya da bir kumanda ba\u011Fla"
    m_Metadata:
      m_Items: []
  - m_Id: 11191324755
    m_Localized: "Bu kumanda desteklenmiyor - Xbox, PlayStation veya Switch Pro kumandas\u0131
      dene"
    m_Metadata:
      m_Items: []
  - m_Id: 11191324756
    m_Localized: "O{0} kumandas\u0131n\u0131n ba\u011Flant\u0131s\u0131 kesildi\nDevam
      etmek i\xE7in herhangi bir kumandada bir tu\u015Fa bas"
    m_Metadata:
      m_Items: []
