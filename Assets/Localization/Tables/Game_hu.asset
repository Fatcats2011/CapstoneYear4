      m_Items: []
  - m_Id: 11191324742
    m_Localized: "Nem siker\xFClt csatlakozni. Lehet, hogy v\xE9get \xE9rt."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324743
    m_Localized: "H\xEDvd meg a bar\xE1taidat a Steam-bar\xE1tlist\xE1dr\xF3l."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324744
    m_Localized: "Lecsatlakoztatva: t\xFAl sok \xFCzenet."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324745
    m_Localized: "Kimaradt\xE1l a visszav\xE1g\xF3b\xF3l."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324746
    m_Localized: "A h\xE1zigazda kil\xE9pett a meccsb\u0151l."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324747
    m_Localized: "A h\xE1zigazda nem \xE9rhet\u0151 el."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324748
    m_Localized: Megszakadt a kapcsolat.
    m_Metadata:
      m_Items: []
  - m_Id: 11191324749
    m_Localized: "Y / H\xE1romsz\xF6g: online j\xE1t\xE9k Steam-bar\xE1tokkal"
    m_Metadata:
      m_Items: []
  - m_Id: 11191324750
    m_Localized: "Y / H\xE1romsz\xF6g: bar\xE1tok megh\xEDv\xE1sa      B / K\xF6r:
      kil\xE9p\xE9s"
    m_Metadata:
      m_Items: []
  - m_Id: 11191324751
    m_Localized: "B / K\xF6r: kil\xE9p\xE9s az online j\xE1t\xE9kb\xF3l"
    m_Metadata:
      m_Items: []
  - m_Id: 11191324752
    m_Localized: "{0}. j\xE1t\xE9kos"
    m_Metadata:
      m_Items: []
  - m_Id: 11191324753
    m_Localized: "Csatlakoztass egy kontrollert a j\xE1t\xE9khoz"
    m_Metadata:
      m_Items: []
  - m_Id: 11191324754
    m_Localized: "Nyomd meg a Sz\xF3k\xF6zt a billenty\u0171zetes j\xE1t\xE9khoz,
      vagy csatlakoztass kontrollert"
    m_Metadata:
      m_Items: []
  - m_Id: 11191324755
    m_Localized: "Ez a kontroller nem t\xE1mogatott - pr\xF3b\xE1lj Xbox, PlayStation
      vagy Switch Pro kontrollert"
    m_Metadata:
      m_Items: []
  - m_Id: 11191324756
    m_Localized: "A {0}. j\xE1t\xE9kos kontrollere lecsatlakozott\nNyomj meg egy
      gombot b\xE1rmelyik kontrolleren a folytat\xE1shoz"
    m_Metadata:
      m_Items: []
  - m_Id: 11191324757
    m_Localized: "Pontsz\xE1m"
    m_Metadata:
      m_Items: []
  - m_Id: 11191324758
    m_Localized: "1. j\xE1t\xE9kos"
    m_Metadata:
      m_Items: []
  - m_Id: 11191324759
    m_Localized: "Aranyrendel\xE9s..."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324760
    m_Localized: "Oktat\xF3anyag bekapcsol\xE1sa"
    m_Metadata:
      m_Items: []
  - m_Id: 11191324761
    m_Localized: "St\xE1b"
