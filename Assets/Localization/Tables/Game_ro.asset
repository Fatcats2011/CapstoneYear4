    m_Metadata:
      m_Items: []
  - m_Id: 11191324727
    m_Localized: "Nu exist\u0103 meciuri deschise acum. Lobby-ul t\u0103u e deschis
      tuturor."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324728
    m_Localized: "Nu exist\u0103 meciuri deschise acum."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324729
    m_Localized: "Caut\u0103 un meci \xEEnainte s\u0103 intre al\u021Bii \xEEn lobby-ul
      t\u0103u."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324730
    m_Localized: Meciul e plin.
    m_Metadata:
      m_Items: []
  - m_Id: 11191324731
    m_Localized: "Meciul a \xEEnceput deja."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324732
    m_Localized: Jocul acela nu e Dead on Arrival.
    m_Metadata:
      m_Items: []
  - m_Id: 11191324733
    m_Localized: Lobby-ul acela nu e un meci Dead on Arrival.
    m_Metadata:
      m_Items: []
  - m_Id: 11191324734
    m_Localized: "Termin\u0103-\u021Bi meciul \xEEnainte s\u0103 intri la un prieten."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324735
    m_Localized: "Ie\u0219i din meciul online \xEEnainte s\u0103 intri \xEEn altul."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324736
    m_Localized: "Meciul e pe versiunea {0} \u0219i tu ai {1}. V\u0103 trebuie aceea\u0219i
      versiune."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324737
    m_Localized: "o versiune necunoscut\u0103"
    m_Metadata:
      m_Items: []
  - m_Id: 11191324738
    m_Localized: "Meciul e pe alt build al versiunii {0}. V\u0103 trebuie acela\u0219i
      build."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324739
    m_Localized: "Porne\u0219te Steam ca s\u0103 joci online."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324740
    m_Localized: "Steam n-a putut deschide un lobby. \xCEncearc\u0103 din nou."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324741
    m_Localized: "Meciul online nu a putut porni. \xCEncearc\u0103 din nou."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324742
    m_Localized: "Nu ai putut intra \xEEn meci. Poate s-a terminat."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324743
    m_Localized: "Invit\u0103 prieteni din lista ta de prieteni Steam."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324744
    m_Localized: 'Deconectat: prea multe mesaje.'
    m_Metadata:
      m_Items: []
  - m_Id: 11191324745
    m_Localized: "Scos din revan\u0219\u0103."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324746
    m_Localized: "Gazda a p\u0103r\u0103sit meciul."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324747
    m_Localized: "Gazda nu a putut fi contactat\u0103."
    m_Metadata:
      m_Items: []
  - m_Id: 11191324748
    m_Localized: Conexiunea s-a pierdut.
    m_Metadata:
      m_Items: []
  - m_Id: 11191324749
    m_Localized: "Y / Triunghi: joac\u0103 online cu prietenii de pe Steam"
    m_Metadata:
      m_Items: []
