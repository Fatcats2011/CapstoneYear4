"AppBuild"
{
	"AppID" "5553880"
	"Desc" "Dead on Arrival Windows, macOS and Linux builds"

	// Folder holding Windows\, macOS\ and Linux\ (relative to this file): Tools → Dead on Arrival → Build → All Three
	"ContentRoot" "..\..\..\Builds\"
	// SteamPipe logs and cache (keep out of git)
	"BuildOutput" "..\..\..\Builds\steampipe-output\"

	// Uncomment to push straight to a branch (never "default" from a script)
	// "SetLive" "beta"

	"Depots"
	{
		"5553881"
		{
			"FileMapping"
			{
				"LocalPath" "Windows\*"
				"DepotPath" "."
				"recursive" "1"
			}
			// Unity writes these next to the build; players don't need them
			"FileExclusion" "*.pdb"
			// Dev-only file for launching outside Steam; Valve advises not shipping it
			"FileExclusion" "steam_appid.txt"
			"FileExclusion" "*_BurstDebugInformation_DoNotShip*"
			"FileExclusion" "*_BackUpThisFolder_ButDontShipItWithYourGame*"
		}
		"5553882"
		{
			"FileMapping"
			{
				"LocalPath" "macOS\*"
				"DepotPath" "."
				"recursive" "1"
			}
			"FileExclusion" "steam_appid.txt"
			"FileExclusion" "*_BurstDebugInformation_DoNotShip*"
			"FileExclusion" "*_BackUpThisFolder_ButDontShipItWithYourGame*"
		}
		"5553883"
		{
			"FileMapping"
			{
				"LocalPath" "Linux\*"
				"DepotPath" "."
				"recursive" "1"
			}
			"FileExclusion" "steam_appid.txt"
			"FileExclusion" "*_BurstDebugInformation_DoNotShip*"
			"FileExclusion" "*_BackUpThisFolder_ButDontShipItWithYourGame*"
		}
	}
}
